# PostgreSQL (required — local dev and production)
# Example (Neon / Supabase / local Docker):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lexio"

# If using a connection pooler (pgbouncer), include channel_binding:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lexio?channel_binding=require&sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
